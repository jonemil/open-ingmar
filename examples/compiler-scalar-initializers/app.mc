using Toybox.Application;
using Toybox.Lang;
using Toybox.System;
const EARLY_NUMBER = NUMBER;
const NUMBER = 40 + 1;
const EARLY_FLOAT = FLOAT;
const FLOAT = 1.5f + 2.25f;
const SUBTRACT = 5.5f - 2;
const MULTIPLY = 1.5f * 2;
const DIVIDE = 7.0f / 2;
const MIXED = 2 + 0.5f;
const LESS = 2 < 2.5f;
const CHAR_EQUAL = 'a' == 97;
const BOOL_EQUAL = true == false;
const SYMBOL_EQUAL = :a == :a;
const NULL_EQUAL = null == 0;
const NAN_EQUAL = NaN == NaN;
const ROUND = 16777216.0f + 1.0f;
const EARLY_ALIAS = ALIAS;
const ALIAS = LITERAL;
const LITERAL = 7;
const SELF_READ = SELF_READ;
const CYCLE_A = CYCLE_B;
const CYCLE_B = CYCLE_A;
const EARLY_FORMAT = FORMAT;
const FORMAT = Lang.NUMBER_FORMAT_UINT16;
const ENDIAN = Lang.ENDIAN_BIG;
module M {
    const EARLY_NUMBER = NUMBER;
    const NUMBER = 40 + 1;
    const EARLY_FLOAT = FLOAT;
    const FLOAT = 1.5f + 2.25f;
    const SUBTRACT = 5.5f - 2;
    const MULTIPLY = 1.5f * 2;
    const DIVIDE = 7.0f / 2;
    const MIXED = 2 + 0.5f;
    const LESS = 2 < 2.5f;
    const CHAR_EQUAL = 'a' == 97;
    const BOOL_EQUAL = true == false;
    const SYMBOL_EQUAL = :a == :a;
    const NULL_EQUAL = null == 0;
    const NAN_EQUAL = NaN == NaN;
    const ROUND = 16777216.0f + 1.0f;
    const EARLY_ALIAS = ALIAS;
    const ALIAS = LITERAL;
    const LITERAL = 7;
    const SELF_READ = SELF_READ;
    const CYCLE_A = CYCLE_B;
    const CYCLE_B = CYCLE_A;
    const EARLY_FORMAT = FORMAT;
    const FORMAT = Lang.NUMBER_FORMAT_UINT16;
    const ENDIAN = Lang.ENDIAN_BIG;
}
class MinimalConsoleApp extends Application.AppBase {
    function initialize() { AppBase.initialize(); }
    function onStart(state) {
        System.println(EARLY_NUMBER == null);
        System.println(NUMBER);
        System.println(EARLY_FLOAT == null);
        System.println(FLOAT);
        System.println(SUBTRACT);
        System.println(MULTIPLY);
        System.println(DIVIDE);
        System.println(MIXED);
        System.println(LESS);
        System.println(CHAR_EQUAL);
        System.println(BOOL_EQUAL);
        System.println(SYMBOL_EQUAL);
        System.println(NULL_EQUAL);
        System.println(NAN_EQUAL);
        System.println(ROUND == 16777216.0f);
        System.println(EARLY_ALIAS == null);
        System.println(ALIAS);
        System.println(SELF_READ == null);
        System.println(CYCLE_A == null);
        System.println(CYCLE_B == null);
        System.println(EARLY_FORMAT == null);
        System.println(M.EARLY_NUMBER == null);
        System.println(M.NUMBER);
        System.println(M.EARLY_FLOAT == null);
        System.println(M.FLOAT);
        System.println(M.SUBTRACT);
        System.println(M.MULTIPLY);
        System.println(M.DIVIDE);
        System.println(M.MIXED);
        System.println(M.LESS);
        System.println(M.CHAR_EQUAL);
        System.println(M.BOOL_EQUAL);
        System.println(M.SYMBOL_EQUAL);
        System.println(M.NULL_EQUAL);
        System.println(M.NAN_EQUAL);
        System.println(M.ROUND == 16777216.0f);
        System.println(M.EARLY_ALIAS == null);
        System.println(M.ALIAS);
        System.println(M.SELF_READ == null);
        System.println(M.CYCLE_A == null);
        System.println(M.CYCLE_B == null);
        System.println(M.EARLY_FORMAT == null);
        var bytes = [0, 0]b;
        bytes.encodeNumber(513, FORMAT, {:endianness => ENDIAN});
        System.println(bytes.toString());
        System.println(bytes.decodeNumber(M.FORMAT, {:endianness => M.ENDIAN}).toString());
        System.exit();
    }
    function getInitialView() { return [new Toybox.WatchUi.View()]; }
}
